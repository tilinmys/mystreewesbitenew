# Clinician backend (optional).
#
# With both set, the homepage rail, /about and /doctors read the roster from
# Supabase. With either missing, the site renders the committed seed in
# src/lib/doctors.ts — so the pages work out of the box and never go blank.
#
# The ANON key is the correct one here: the doctors table is world-readable
# published content behind a read-only RLS policy. Do NOT put a service-role
# key in this file; it would hand write access to anything that reads the env.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shared secret for POST /api/revalidate/doctors, which pushes a backend edit
# onto the live pages immediately. Send it as the x-revalidate-secret header.
# Without it the route refuses rather than running unauthenticated.
REVALIDATE_SECRET=

# Blog backend (optional). The admin dashboard's API; posts are read from
# {CMS_API_URL}/website/blogs. Defaults to https://mystree-backend.fly.dev.
CMS_API_URL=
